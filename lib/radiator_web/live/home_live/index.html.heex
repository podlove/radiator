<Layouts.app flash={@flash}>
  <div class="text-center">
    <h1 class="my-4 text-6xl">Radiator</h1>
    <p class="text-xl">The spark ✨ that lights the fire 🔥</p>
  </div>

  <div id="podcasts" class="flex gap-4" phx-update="stream">
    <.card_podcast :for={{id, podcast} <- @streams.podcasts} id={id} podcast={podcast} />
  </div>
  <.card_feature />
</Layouts.app>
